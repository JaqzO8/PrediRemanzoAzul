# Entorno del servidor
APP_NAME=PrediRemanzoAzul
APP_VERSION=1.0.0
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DEBUG=false
CORS_ORIGINS=["*"]

# Ubicación de Remanzo Azul
REMANZO_AZUL_NOMBRE="Remanzo Azul"
REMANZO_AZUL_LATITUDE=6.2975
REMANZO_AZUL_LONGITUDE=-75.0350
REMANZO_AZUL_TIMEZONE=America/Bogota

# API de Clima Existente (ProyectoClimatico)
WEATHER_API_BASE_URL=http://127.0.0.1:8000/api/v1
WEATHER_API_TIMEOUT_SECONDS=4.0

# Resiliencia y Fallback Clima (Open-Meteo directo si la API local no está corriendo)
FALLBACK_OPEN_METEO_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Fuente de Datos Históricos
HISTORICO_CSV_PATH=data/historico_visitas_remanzo_azul.csv
